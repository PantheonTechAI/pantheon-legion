{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pantheon:tabula:schema:corpus-reread:v1",
  "title": "Pantheon Tabula Exact Corpus Reread Contract",
  "description": "All-or-nothing verification of current records against recorded bounded UTF-8 prefixes. Distinct record IDs, exact ordered count, sum(content_bytes) <= 32768 and digest/byte matching are additionally enforced by both implementations.",
  "$defs": {
    "binding_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "correlation_id",
        "binding",
        "intent",
        "projection",
        "references"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "binding": {
          "$ref": "#/$defs/binding_reference"
        },
        "intent": {
          "const": "SCOUT_EVIDENCE"
        },
        "projection": {
          "const": "utf8-prefix-v1"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "domain",
        "revision",
        "canonical_uri",
        "source",
        "recorded_at",
        "retrieved_at",
        "selection_explanation",
        "content"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "canonical_uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation"
          ],
          "properties": {
            "citation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "uri": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            }
          }
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "selection_explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "description": "Strict UTF-8 encoded size equals the recorded byte count, at most 8192 bytes."
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "correlation_id",
        "binding",
        "results",
        "tabula_audit_correlation_id"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "binding": {
          "$ref": "#/$defs/binding_reference"
        },
        "results": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/record"
          },
          "minItems": 1
        },
        "tabula_audit_correlation_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "revision",
        "content_bytes",
        "content_sha256"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "content_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
