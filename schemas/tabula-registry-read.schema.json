{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pantheon:tabula:schema:registry-read:v1",
  "title": "Pantheon Tabula Registry Read Contract",
  "description": "Versioned request and success-response shapes for authorized Registry discovery. Registry results are discovery metadata, not execution authority.",
  "$defs": {
    "binding_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string", "format": "uuid"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "correlation_id", "binding", "intent", "query", "limit"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "request_id": {"type": "string", "format": "uuid"},
        "correlation_id": {"type": "string", "format": "uuid"},
        "binding": {"$ref": "#/$defs/binding_reference"},
        "intent": {"type": "string", "enum": ["SCOUT_DISCOVERY", "OPERATOR_DISCOVERY"]},
        "query": {"type": "string", "minLength": 1, "maxLength": 2000},
        "limit": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_id", "kind", "version", "lifecycle_state", "validation_result"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1, "maxLength": 512},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "lifecycle_state": {"type": "string", "enum": ["ACTIVE", "DEPRECATED", "RETIRED"]},
        "validation_result": {"type": "string", "enum": ["VALID", "WARNING", "INVALID"]},
        "artifact_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "artifact_uri": {"type": "string", "format": "uri", "maxLength": 2048}
      },
      "anyOf": [{"required": ["artifact_hash"]}, {"required": ["artifact_uri"]}]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "correlation_id", "binding", "results", "tabula_audit_correlation_id"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "request_id": {"type": "string", "format": "uuid"},
        "correlation_id": {"type": "string", "format": "uuid"},
        "binding": {"$ref": "#/$defs/binding_reference"},
        "results": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/entity"}},
        "tabula_audit_correlation_id": {"type": "string", "format": "uuid"}
      }
    }
  }
}
