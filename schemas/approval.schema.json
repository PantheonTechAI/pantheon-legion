{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pantheon-legion:schema:approval:v1",
  "title": "Pantheon Legion Approval",
  "description": "A time- and scope-bound authorization decision for a proposed Mission action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "mission_id",
    "command_id",
    "action_id",
    "mission_version",
    "roe_revision",
    "action_hash",
    "requested_by",
    "status",
    "requested_at",
    "expires_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "1.0"
    },
    "mission_id": {
      "type": "string",
      "format": "uuid"
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "action_id": {
      "type": "string",
      "format": "uuid"
    },
    "mission_version": {
      "type": "integer",
      "minimum": 1
    },
    "roe_revision": {
      "type": "integer",
      "minimum": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "action_hash": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "scope": {
      "$ref": "#/$defs/approval_scope"
    },
    "requested_by": {
      "$ref": "#/$defs/principal"
    },
    "approver": {
      "anyOf": [
        {
          "$ref": "#/$defs/principal"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "DENIED", "REVOKED", "EXPIRED", "CONSUMED"]
    },
    "decision_reason": {
      "type": "string",
      "maxLength": 5000
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "consumed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "authorization_context": {
      "$ref": "#/$defs/authorization_context"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["APPROVED", "DENIED", "REVOKED", "CONSUMED"]}},
        "required": ["status"]
      },
      "then": {
        "required": ["approver", "decided_at", "decision_reason"]
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "CONSUMED"}},
        "required": ["status"]
      },
      "then": {
        "required": ["consumed_at"]
      }
    }
  ],
  "$defs": {
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "subject"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["HUMAN", "WORKLOAD", "SYSTEM", "EXTERNAL"]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "issuer": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "approval_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "side_effect_class"],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "side_effect_class": {
          "type": "string",
          "enum": ["READ", "ANALYSIS", "MUTATION", "EXTERNAL_SIDE_EFFECT"]
        },
        "target": {
          "type": "string",
          "maxLength": 1000
        },
        "environment_id": {
          "type": ["string", "null"],
          "format": "uuid"
        }
      }
    },
    "authorization_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "evaluated_at"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["ALLOW", "DENY"]
        },
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_bundle": {
          "type": "string",
          "maxLength": 500
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
