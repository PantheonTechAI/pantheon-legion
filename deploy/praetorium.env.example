LEGION_DATABASE=/var/lib/legion/aquila.sqlite3
LEGION_OIDC_ISSUER=https://auth.texasfight.net/application/o/legion/
LEGION_OIDC_AUDIENCE=aquila
TABULA_CONSOLE_URL=https://tabula.texasfight.net
# Temporary browser-test scope. Praetorium requires these settings at startup
# and supplies them server-side; browser form input cannot override them.
LEGION_DEFAULT_ORGANIZATION_ID=11111111-1111-4111-8111-111111111111
LEGION_DEFAULT_WORKSPACE_ID=22222222-2222-4222-8222-222222222222
# Optional read-only Runtime organization panel. When omitted or unavailable,
# Mission detail remains usable and the panel reports an unavailable status.
# LEGION_RUNTIME_DATABASE_URL=postgresql+psycopg://legion_runtime:replace-me@127.0.0.1:5434/legion_runtime
# Values are bounded at startup: pool 50-1000 ms, connect 250-3000 ms,
# statement 100-2000 ms.
LEGION_RUNTIME_POOL_TIMEOUT_MS=250
LEGION_RUNTIME_CONNECT_TIMEOUT_MS=1000
LEGION_RUNTIME_STATEMENT_TIMEOUT_MS=500
