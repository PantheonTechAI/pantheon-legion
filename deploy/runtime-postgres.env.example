# Legion Runtime owns this database. Do not point it at a Tabula or Aquila DB.
LEGION_RUNTIME_DB_NAME=legion_runtime_test
LEGION_RUNTIME_DB_USER=legion_runtime
LEGION_RUNTIME_DB_PASSWORD=replace-with-a-local-secret
LEGION_RUNTIME_DB_PORT=5434

# Illustrative deployed Runtime URL. The disposable Compose service does not
# create this database; production composition owns provisioning separately.
LEGION_RUNTIME_DATABASE_URL=postgresql+psycopg://legion_runtime:replace-with-a-local-secret@127.0.0.1:5434/legion_runtime

# Tests truncate all Runtime tables. It is intentionally a separate variable.
LEGION_RUNTIME_TEST_DATABASE_URL=postgresql+psycopg://legion_runtime:replace-with-a-local-secret@127.0.0.1:5434/legion_runtime_test
